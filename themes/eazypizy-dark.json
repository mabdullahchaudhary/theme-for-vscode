  "tokenColors": [
    {
      "name": "Comments (Muted Slate)",
      "scope": [
        "comment",
        "comment.block",
        "comment.line",
        "comment.documentation",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6B7280",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Base text (UI foreground)",
      "scope": [
        "text",
        "source",
        "meta.embedded",
        "meta.tag.inline.any.html",
        "meta.tag.block.any.html"
      ],
      "settings": {
        "foreground": "#E2E8F0"
      }
    },
    {
      "name": "Keywords, Control Flow & Storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "keyword.other",
        "storage.type",
        "storage.modifier",
        "storage.modifier.import",
        "storage.modifier.export",
        "storage.modifier.async",
        "storage.modifier.static",
        "storage.modifier.public",
        "storage.modifier.private",
        "storage.modifier.protected",
        "storage.modifier.readonly"
      ],
      "settings": {
        "foreground": "#F43F5E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.relational",
        "keyword.operator.ternary",
        "keyword.operator.type",
        "punctuation",
        "punctuation.definition",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.section",
        "punctuation.section.embedded",
        "punctuation.separator.continuation",
        "punctuation.separator.delimiter",
        "punctuation.separator.key-value",
        "punctuation.separator.namespace",
        "punctuation.separator.scope-resolution",
        "punctuation.separator.inheritance",
        "punctuation.separator.annotation",
        "punctuation.separator.generic",
        "punctuation.separator.template"
      ],
      "settings": {
        "foreground": "#94A3B8"
      }
    },
    {
      "name": "Numbers, Booleans & Constants",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.numeric.octal",
        "constant.numeric.binary",
        "constant.language",
        "constant.language.boolean",
        "constant.character",
        "constant.character.escape",
        "constant.other",
        "constant.other.symbol",
        "constant.other.key",
        "constant.other.caps",
        "support.constant"
      ],
      "settings": {
        "foreground": "#C084FC"
      }
    },
    {
      "name": "Strings & Template Literals",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.quoted.triple",
        "string.unquoted",
        "string.interpolated",
        "string.regexp",
        "string.other.link",
        "string.other",
        "meta.string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#34D399"
      }
    },
    {
      "name": "Escape Sequences",
      "scope": [
        "constant.character.escape",
        "constant.character.escape.backslash",
        "constant.character.escape.json",
        "constant.character.escape.yaml"
      ],
      "settings": {
        "foreground": "#C084FC",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Regular Expressions",
      "scope": [
        "string.regexp",
        "string.regexp.character-class",
        "string.regexp constant.character",
        "string.regexp constant.character.escape"
