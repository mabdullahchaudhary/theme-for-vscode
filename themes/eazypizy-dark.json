        "markup.inserted",
        "markup.changed",
        "markup.conflict"
      ],
      "settings": {
        "foreground": "#F43F5E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Semantic Tokens (TypeScript/JavaScript)",
      "scope": [
        "variable.other.readwrite.ts",
        "variable.other.readwrite.tsx",
        "variable.other.readwrite.js",
        "variable.other.readwrite.jsx",
        "entity.name.function.ts",
        "entity.name.function.tsx",
        "entity.name.function.js",
        "entity.name.function.jsx"
      ],
      "settings": {
        "foreground": "#FBBF24"
      }
    },
    {
      "name": "Diagnostics & Invalid Syntax",
      "scope": [
        "invalid",
        "invalid.deprecated",
        "invalid.illegal",
        "invalid.unimplemented",
        "invalid.broken",
        "invalid.error"
      ],
      "settings": {
        "foreground": "#F43F5E",
        "fontStyle": "underline bold"
      }
    }
  ]
}
